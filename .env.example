# Vorlage: kopieren nach .env und Werte eintragen. .env niemals hochladen.

# OpenAI-kompatible Schnittstelle für Sprach-, Embedding- und Übersetzungsmodell
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gemma4-31b-it
EMBEDDING_MODEL=octen-embedding-8b
TRANSLATION_MODEL=qwen3-next-80b-a3b-instruct

# Manifesto Project (kostenloser Schlüssel: https://manifesto-project.wzb.eu/)
MANIFESTO_API_KEY=
MANIFESTO_CORE_VERSION=MPDS2024a
# leer = neueste Korpusversion
MANIFESTO_CORPUS_VERSION=

# Hugging Face (für ManifestoBERTa, falls nötig)
HF_TOKEN=

# Parallele Anfragen
MAX_WORKERS=4
